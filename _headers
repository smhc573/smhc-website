/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.cqc.org.uk https://*.cqc.org.uk; style-src 'self' 'unsafe-inline' https://www.cqc.org.uk https://*.cqc.org.uk; img-src 'self' data: https://www.cqc.org.uk https://*.cqc.org.uk; font-src 'self' https://www.cqc.org.uk https://*.cqc.org.uk; frame-src https://www.cqc.org.uk https://*.cqc.org.uk; connect-src 'self' https://www.cqc.org.uk https://*.cqc.org.uk; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=2592000

/img/*
  Cache-Control: public, max-age=2592000

