# St Matthews Healthcare website: Apache settings
# Generated by launch.py

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# The GitHub read-me is for IT, not for visitors
RedirectMatch 404 ^/README\.md$

<IfModule mod_rewrite.c>
RewriteEngine On

# One address for the site: https and no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://smhc.uk.com/$1 [R=301,L]

# Pages from the old website
RewriteRule ^home/?$ / [R=301,L,NC]
RewriteRule ^about\-us/privacy\-policy/?$ /privacy/ [R=301,L,NC]
RewriteRule ^about\-us/?$ /about/ [R=301,L,NC]
RewriteRule ^our\-ethos/?$ /about/ [R=301,L,NC]
RewriteRule ^research/?$ /about/ [R=301,L,NC]
RewriteRule ^why\-smhc/?$ /about/ [R=301,L,NC]
RewriteRule ^colleagues\-feedback/?$ /careers/ [R=301,L,NC]
RewriteRule ^contact\-us/?$ /contact/ [R=301,L,NC]
RewriteRule ^care\-facilities/?$ /services/ [R=301,L,NC]
RewriteRule ^care\-facilities/the\-dallingtons\-mental\-health\-hospital/?$ /services/the-dallingtons/ [R=301,L,NC]
RewriteRule ^care\-facilities/st\-matthews\-hospital/?$ /services/st-matthews-hospital/ [R=301,L,NC]
RewriteRule ^care\-facilities/broomhill\-mental\-health\-hospital\-2/?$ /services/althorp-grange/ [R=301,L,NC]
RewriteRule ^care\-facilities/althorp\-grange/?$ /services/althorp-grange/ [R=301,L,NC]
RewriteRule ^care\-facilities/st\-matthews\-unit\-care\-home/?$ /services/st-matthews-unit/ [R=301,L,NC]
RewriteRule ^care\-facilities/kingsthorpe\-grange/?$ /services/kingsthorpe-grange/ [R=301,L,NC]
RewriteRule ^care\-facilities/the\-avenue\-care\-home/?$ /services/the-avenue/ [R=301,L,NC]
RewriteRule ^care\-facilities/willowbrook\-house\-care\-home/?$ /services/willowbrook-house/ [R=301,L,NC]
RewriteRule ^care\-facilities/maple\-leaf\-house\-nursing\-care\-home\-coventry/?$ /services/maple-leaf-house/ [R=301,L,NC]
RewriteRule ^care\-facilities/hawthorne\-house\-care\-home\-coventry/?$ /services/hawthorne-house/ [R=301,L,NC]
RewriteRule ^care\-facilities/the\-moreton\-centre\-nursing\-care\-home/?$ /services/the-moreton-centre/ [R=301,L,NC]
RewriteRule ^nursing\-home\-the\-avenue/?$ /services/the-avenue/ [R=301,L,NC]
RewriteRule ^care\-types/?$ /services/ [R=301,L,NC]
RewriteRule ^mental\-health\-hospitals/?$ /services/ [R=301,L,NC]
RewriteRule ^hospital\-care/?$ /services/ [R=301,L,NC]
RewriteRule ^dementia\-care/?$ /services/ [R=301,L,NC]
RewriteRule ^community\-based\-mdt\-pathways/?$ /services/ [R=301,L,NC]
RewriteRule ^mental\-health\-nursing\-care\-homes/?$ /services/ [R=301,L,NC]
RewriteRule ^careers/register\-your\-interest/?$ /careers/ [R=301,L,NC]
RewriteRule ^careers/recruitment\-event\-for\-nurses/?$ /careers/ [R=301,L,NC]
RewriteRule ^Careers/?$ /careers/ [R=301,L]

# Anything else under the old sections
RewriteRule ^care\-facilities/ /services/ [R=301,L,NC]
RewriteRule ^care\-types/ /services/ [R=301,L,NC]
RewriteRule ^about\-us/ /about/ [R=301,L,NC]
RewriteRule ^job\-openings/ /careers/ [R=301,L,NC]
RewriteRule ^job\-category/ /careers/ [R=301,L,NC]
RewriteRule ^job\-type/ /careers/ [R=301,L,NC]
RewriteRule ^jobs/ /careers/ [R=301,L,NC]
RewriteRule ^2012/ /news/ [R=301,L,NC]
RewriteRule ^2013/ /news/ [R=301,L,NC]
RewriteRule ^2014/ /news/ [R=301,L,NC]
RewriteRule ^2015/ /news/ [R=301,L,NC]
RewriteRule ^2016/ /news/ [R=301,L,NC]
RewriteRule ^2017/ /news/ [R=301,L,NC]
RewriteRule ^2018/ /news/ [R=301,L,NC]
RewriteRule ^2019/ /news/ [R=301,L,NC]
RewriteRule ^2020/ /news/ [R=301,L,NC]
RewriteRule ^2021/ /news/ [R=301,L,NC]
RewriteRule ^2022/ /news/ [R=301,L,NC]
RewriteRule ^2023/ /news/ [R=301,L,NC]
RewriteRule ^2024/ /news/ [R=301,L,NC]
RewriteRule ^2025/ /news/ [R=301,L,NC]
RewriteRule ^2026/ /news/ [R=301,L,NC]
RewriteRule ^wp-(admin|login|content|includes) - [G,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.cqc.org.uk https://*.cqc.org.uk; style-src 'self' 'unsafe-inline' https://www.cqc.org.uk https://*.cqc.org.uk; img-src 'self' data: https://www.cqc.org.uk https://*.cqc.org.uk; font-src 'self' https://www.cqc.org.uk https://*.cqc.org.uk; frame-src https://www.cqc.org.uk https://*.cqc.org.uk; connect-src 'self' https://www.cqc.org.uk https://*.cqc.org.uk; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
<FilesMatch "\.(html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(css|js|woff2|jpg|png|ico|pdf)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
